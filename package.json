{
  "name": "encurtador",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["web"],
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.5"
  },
  "description": "Encurtador de URLs na Cloudflare Workers + KV",
  "scripts": {
    "build": "npm run build --workspace web",
    "test": "npm run build && node tests/audit.mjs",
    "dev": "npm run build && wrangler dev",
    "dev:web": "npm run dev --workspace web",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace web",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.140.0"
  }
}
